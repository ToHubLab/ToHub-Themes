{
  "manifest_version": 2,
  "name": "Wasteland - The Hot Grain",
  "version": "1.0",
  "description": "A post-apocalyptic Firefox theme with warm dust, rust, and hot grain tones.",
  "author": "ToHubLabs",
  "homepage_url": "https://tohub.rf.gd",

  "developer": {
    "name": "ToHubLabs",
    "url": "https://tohub.rf.gd"
